# Alexandria MCP Full-Stack Configuration

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend Configuration
FRONTEND_SERVER_URL=http://localhost:8000/mcp
FRONTEND_LOG_VERBOSE=true

# Alexandria Core Services
SENTINELLE_URL=http://localhost:9000
PAINT_SHOP_URL=http://localhost:5000
AEGIS_URL=http://localhost:7000
CHAPEL_URL=http://localhost:6000

# DeepCode Service
DEEPCODE_URL=http://localhost:8001

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# TimescaleDB
TIMESCALEDB_URL=postgresql://alexandria:password@localhost:5432/alexandria

# Vault Secrets Management
VAULT_URL=http://localhost:8200
VAULT_ROOT_TOKEN=

# OpenAI/LLM Configuration (for agents)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic Claude Configuration (optional)
ANTHROPIC_API_KEY=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Features
ENABLE_DEEPCODE=true
ENABLE_AGENTS=true
ENABLE_FORENSICS=true
ENABLE_AUDIT_LOGGING=true
